<%= form_with(model: @user, url: hero_proficiency_path, method: :patch) do |f| %>
  <div class="accordion" id="heroProficiencyAccordion">
    <% @heroes_by_role.each_with_index do |(role, heroes_in_role), index| %>
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-<%= role %>">
          <button class="accordion-button <%= 'collapsed' if index > 0 %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= role %>" aria-expanded="<%= index == 0 %>" aria-controls="collapse-<%= role %>">
            <%= Hero.human_attribute_name("role.#{role}") %>
          </button>
        </h2>
        <div id="collapse-<%= role %>" class="accordion-collapse collapse <%= 'show' if index == 0 %>" aria-labelledby="heading-<%= role %>" data-bs-parent="#heroProficiencyAccordion">
          <div class="accordion-body">
            <div class="row">
              <%= f.fields_for :hero_proficiencies, @user.hero_proficiencies.sort_by { |p| p.hero.name } do |proficiency_form| %>
                <% if proficiency_form.object.hero.role == role %>
                  <% hero = proficiency_form.object.hero %>
                  <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                      <div class="card-body text-center">
                        <%= image_tag(asset_path(hero[:icon_url]), style: "width: 50px; height: 50px; object-fit: cover;") %>
                        <strong class="d-block mt-2 mb-3 fs-5"><%= hero.name %></strong>

                        <div class="star-rating">
                          <%# 表示順番を逆に %>
                          <% HeroProficiency.proficiency_levels.keys.reverse.each do |level| %>
                            <%= proficiency_form.radio_button :proficiency_level, level, id: "rating-#{hero.id}-#{level}" %>
                            <%= proficiency_form.label :proficiency_level, "★", for: "rating-#{hero.id}-#{level}", title: t("enums.hero_proficiency.proficiency_level.#{level}") %>
                          <% end %>
                        </div>
                        
                        <%= proficiency_form.hidden_field :hero_id %>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-grid mt-4">
    <%= f.submit "習熟度を保存する", class: "btn btn-primary" %>
  </div>
<% end %>

