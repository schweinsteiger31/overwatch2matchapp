<%= form_with(model: play_model) do |f| %>
  <%# --- エラーメッセージ表示 --- %>
  <% if play_model.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% play_model.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# --- プレイ時間 --- %>
  <div class="mb-3">
    <%= f.label :play_time_id, "主なプレイ時間", class: "form-label" %>
    <%= f.select :play_time_id, PlayTime.all.map { |pt| [t("enums.play_time.time_slot.#{pt.time_slot}"), pt.id] }, { prompt: "選択してください" }, { class: "form-select" } %>
  </div>

  <%# --- プレイスタイル --- %>
  <div class="mb-3">
    <%= f.label :play_style_id, "プレイスタイル", class: "form-label" %>
    <%= f.select :play_style_id, PlayStyle.all.map { |ps| [t("enums.play_style.style.#{ps.style}"), ps.id] }, { prompt: "選択してください" }, { class: "form-select" } %>
  </div>

  <%# --- VCのありなし (TalkStyle) --- %>
  <div class="mb-3">
    <%= f.label :talk_style_id, "ボイスチャット", class: "form-label" %>
    <%= f.select :talk_style_id, TalkStyle.all.map { |ts| [t("enums.talk_style.vc.#{ts.vc}"), ts.id] }, { prompt: "選択してください" }, { class: "form-select" } %>
  </div>

  <hr class="my-4">

  <%# --- ロール別ランク --- %>
  <h5 class="mb-3">ロール別ランク</h5>
    <div class="row">
     <div class="col-md-4 mb-3 mb-md-0">
        <%= f.label :tank_rank_id, "タンク", class: "form-label" %>
        <%= f.select :tank_rank_id, Rank.all.map { |r| [t("enums.rank.tier.#{r.tier}"), r.id] }, { prompt: "未設定" }, { class: "form-select" } %>
     </div>
     <div class="col-md-4 mb-3 mb-md-0">
        <%= f.label :damage_rank_id, "ダメージ", class: "form-label" %>
        <%= f.select :damage_rank_id, Rank.all.map { |r| [t("enums.rank.tier.#{r.tier}"), r.id] }, { prompt: "未設定" }, { class: "form-select" } %>
     </div>
     <div class="col-md-4">
        <%= f.label :support_rank_id, "サポート", class: "form-label" %>
        <%= f.select :support_rank_id, Rank.all.map { |r| [t("enums.rank.tier.#{r.tier}"), r.id] }, { prompt: "未設定" }, { class: "form-select" } %>
     </div>
    </div>

  <hr class="my-4">
  
  <%# ひとことコメント %>
  <h5 class="mb-3">ひとことコメント</h5>
  <div class="mb-3">
    <%= f.label :comment, "自己紹介コメント (20文字以内)", class: "form-label" %>
    <%= f.text_area :comment, rows: 2, class: "form-control" %>
  </div>
  <%# ▲▲▲▲▲ ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ %>
  
  <div class="d-grid mt-4">
    <% if play_model.persisted? %>
      <%= f.submit "更新する", class: "btn btn-primary" %>
    <% else %>
      <%= f.submit "登録する", class: "btn btn-primary" %>
    <% end %>
  </div>
<% end %>

