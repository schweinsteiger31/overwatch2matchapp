<div class="container my-5">
  <h2 class="text-center mb-4">あなたに「いいね！」を送ったユーザー</h2>

  <div class="row">
    <% if @liking_users.present? %>
      <% @liking_users.each do |user| %>
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <div class="card-body text-center d-flex flex-column">
              <img src="https://placehold.co/100x100" class="rounded-circle mb-3 mx-auto" alt="<%= user.name %>">
              
              <h5 class="card-title"><%= user.name %></h5>
              
              <div class="mt-auto">
                <%# 「詳しくみる」ボタン %>
                <%= link_to "詳しくみる", user_path(user), class: "btn btn-outline-primary me-2" %>
                
                <%# 「いいね！を返す」ボタン %>
                <% if !current_user.liked_users.include?(user) %>
                  <%= button_to "いいね！を返す", user_like_path(user), method: :post, class: "btn btn-success" %>
                <% else %>
                  <span class="btn btn-secondary disabled">いいね！済み</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center text-muted">まだ誰からも「いいね！」されていません。</p>
    <% end %>
  </div>
</div>
