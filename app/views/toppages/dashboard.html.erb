<div class="container my-5">
  <h2 class="text-center mb-4">あなたへのおすすめユーザー</h2>

  <%= turbo_stream_from "users_list" %>
  <div id="users_list" class="row">
    <%= render partial: "toppages/user_card", collection: @recommended_users, as: :recommendation %>
  </div>
  
  <div id="pagy-container">
    <%= render "toppages/pagy_control" %>
  </div>
</div>

