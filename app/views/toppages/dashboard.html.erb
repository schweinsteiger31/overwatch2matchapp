<div class="container my-5">
  <h2 class="text-center mb-4">あなたへのおすすめユーザー</h2>

  <div class="row">
    <% @recommended_users.each do |recommendation| %>
      <% user = recommendation[:user] %>
      <% score = recommendation[:score] %>
      
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body text-center d-flex flex-column">
            <img src="https://placehold.co/100x100" class="rounded-circle mb-3 mx-auto" alt="<%= user.name %>">
            
            <h5 class="card-title"><%= user.name %></h5>
            
            <p class="card-text">
              <small class="text-muted">相性スコア: <%= score %></small>
            </p>

            <div class="mt-auto">
              <%= link_to "詳しくみる", user_path(user), class: "btn btn-primary" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>