<% user = recommendation[:user] %>
<% score = recommendation[:score] %>

<div class="col-md-4 mb-4">
  <div class="card h-100 shadow-sm">
    <div class="card-body text-center d-flex flex-column">
      <% if user.avatar.attached? %>
        <%= image_tag user.avatar, class: "rounded-circle mb-3 mx-auto", style: "width: 100px; height: 100px; object-fit: cover;" %>
      <% else %>
        <img src="https://placehold.co/100x100/EFEFEF/AAAAAA&text=Icon" class="rounded-circle mb-3 mx-auto" alt="<%= user.name %>">
      <% end %>

      <h5 class="card-title"><%= user.name %></h5>
      
      <div class="speech-bubble mb-3">
        <p class="speech-bubble-text m-0">
          <%= user.play_model&.comment.presence || "よろしくお願いします！" %>
        </p>
      </div>

      <p class="card-text">
        <small class="text-muted">相性スコア: <%= score %></small>
      </p>
      <div class="mt-auto">
        <%= link_to "詳しくみる", user_path(user), class: "btn btn-primary", data: { turbo_frame: "_top" } %>
      </div>
    </div>
  </div>
</div>

