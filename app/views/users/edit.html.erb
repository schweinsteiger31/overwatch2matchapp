<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header text-center">
          <h2 class="mb-0">プロフィール情報</h2>
        </div>
        <div class="card-body p-4 p-md-5">
          <%= form_with(model: @user, url: @user.new_record? ? users_path : user_path(@user), multipart: true) do |f| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <ul>
                  <% @user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="form-group mb-3 text-center">
              <%= f.label :avatar, "アイコン画像", class: "form-label d-block mb-2" %>
              <div class="position-relative d-inline-block" style="width: 120px; height: 120px;">
                <%= image_tag (@user.avatar.attached? ? @user.avatar : "https://placehold.co/120x120/EFEFEF/AAAAAA&text=Icon"), class: "rounded-circle", style: "width: 100%; height: 100%; object-fit: cover;" %>
                <%= f.label :avatar, class: "avatar-upload-label" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                <% end %>
                <%= f.file_field :avatar, class: "d-none", id: "user_avatar" %>
              </div>
            </div>

            <div class="form-group mb-3">
              <%= f.label :name, "ユーザー名", class: "form-label" %>
              <%= f.text_field :name, class: "form-control", autofocus: true %>
            </div>

            <div class="form-group mb-3">
              <%= f.label :age, "年齢", class: "form-label" %>
              <%= f.number_field :age, class: "form-control", min: 18 %>
            </div>

            <div class="form-group mb-3">
              <%= f.label :gender, "性別", class: "form-label" %>
              <%= f.select :gender, User.genders_i18n.invert, { prompt: "選択してください" }, class: "form-select" %>
            </div>
            
            <div class="form-group mb-3">
              <%= f.label :discord_id, "Discord ID", class: "form-label" %>
              <small class="form-text text-muted d-block">(例: username) <span class="text-danger">*必須</span></small>
              <div class="input-group">
                <span class="input-group-text">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M13.545 2.907a13.227 13.227 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.19 12.19 0 0 0-3.658 0 8.258 8.258 0 0 0-.412-.833.051.051 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.041.041 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032c.001.014.01.028.021.037a13.276 13.276 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019c.308-.42.0582-.863.818-1.329a.05.05 0 0 0-.01-.059.051.051 0 0 0-.018-.011 8.875 8.875 0 0 1-1.248-.595.05.05 0 0 1-.02-.066.051.051 0 0 1 .015-.019c.084-.063.168-.129.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.073 0a.052.052 0 0 1 .053.007c.08.066.164.132.248.195a.051.051 0 0 1 .015.019.051.051 0 0 1-.02.066 8.875 8.875 0 0 1-1.248-.595.05.05 0 0 0-.01.059.051.051 0 0 0-.018.011c.236.466.51.909.818 1.329a.05.05 0 0 0 .056.019 13.235 13.235 0 0 0 4.001-2.02.049.049 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.125a.043.043 0 0 0-.021-.018Z"/>
                  </svg>
                </span>
                <%= f.text_field :discord_id, class: "form-control", required: true, placeholder: "username" %>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= f.submit "登録する", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .avatar-upload-label {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    cursor: pointer;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }
  .avatar-upload-label:hover {
    opacity: 1;
  }
</style>

