<div class="container">
  <div class="row d-flex justify-content-center mt-5">
    <div class="col-md-6">
      <h1 class="text-center mb-4">ユーザー情報編集</h1>

      <%= form_with model: @user do |form| %>
        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <ul>
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= form.label :name, "ユーザー名", class: "form-label" %>
          <%= form.text_field :name, class: "form-control" %>
        </div>
        
        <div class="mb-3">
          <%= form.label :age, "年齢", class: "form-label" %>
          <%= form.number_field :age, class: "form-control" ,min: 0 %>
        </div>
        
        <div class="mb-3">
          <%= form.label :gender, "性別", class: "form-label" %>
          <%= form.select :gender, User.genders_i18n.invert, { prompt: "選択してください" }, class: "form-select" %>
        </div>
        
        <div class="d-grid gap-2">
          <%= form.submit "登録する", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>