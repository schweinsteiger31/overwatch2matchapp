<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <%# --- 基本情報 --- %>
      <div class="text-center mb-4">
        <img src="https://placehold.co/150x150" class="rounded-circle mb-3" alt="<%= @user.name %>">
        <h1><%= @user.name %></h1>
        <p class="text-muted">
          <%= @user.age %>歳 / <%= t("enums.user.gender.#{@user.gender}") %>
        </p>
      </div>

      <%# --- アクションボタン（自分のページか、他人のページかで表示を切り替え） --- %>
      <div class="text-center mb-4">
        <% if @user == current_user %>
          <% if @user.play_model.present? %>
            <%= link_to "プレイ情報を編集", edit_play_model_path(@user.play_model), class: "btn btn-outline-secondary me-2" %>
          <% else %>
            <%= link_to "プレイ情報を登録する", new_play_model_path, class: "btn btn-outline-primary me-2" %>
          <% end %>
          <%= link_to "ヒーロー習熟度を編集", edit_hero_proficiency_path, class: "btn btn-outline-info" %>
        
        <% else %>
          <% if current_user.matched_with?(@user) %>
            <div class="card bg-light">
              <div class="card-body">
                <h5 class="card-title">🎉 マッチング成立！</h5>
                <p class="card-text">
                  Discordで連絡を取り合ってみましょう。
                </p>
              </div>
            </div>
          <% else %>
            <% if !current_user.liked_users.include?(@user) %>
              <%= button_to "❤️ 一緒に遊びませんか？ (いいね！)", user_like_path(@user), method: :post, class: "btn btn-success btn-lg" %>
            <% else %>
              <%= button_to "💔 いいね！を取り消す", user_like_path(@user), method: :delete, class: "btn btn-danger btn-lg" %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <%# --- プレイモデル情報 --- %>
      <% if @user.play_model.present? %>
        <div class="card mb-4">
          <div class="card-header">
            プレイスタイル
          </div>
          <div class="card-body">
            <p><strong>主なプレイ時間:</strong> <%= t("enums.play_time.time_slot.#{@user.play_model&.play_time&.time_slot}") %></p>
            <p><strong>プレイスタイル:</strong> <%= t("enums.play_style.style.#{@user.play_model&.play_style&.style}") %></p>
            <p><strong>ボイスチャット:</strong> <%= t("enums.talk_style.vc.#{@user.play_model&.talk_style&.vc}") %></p>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header">
            ロール別ランク
          </div>
          <div class="card-body row text-center">
            <div class="col">
              <h5>タンク</h5>
              <p><%= t("enums.rank.tier.#{@user.play_model&.tank_rank&.tier}") %></p>
            </div>
            <div class="col">
              <h5>ダメージ</h5>
              <p><%= t("enums.rank.tier.#{@user.play_model&.damage_rank&.tier}") %></p>
            </div>
            <div class="col">
              <h5>サポート</h5>
              <p><%= t("enums.rank.tier.#{@user.play_model&.support_rank&.tier}") %></p>
            </div>
          </div>
        </div>
      <% else %>
        <div class="alert alert-secondary text-center">
          まだプレイ情報が登録されていません。
        </div>
      <% end %>

      <%# --- ヒーロー習熟度 --- %>
      <div class="card">
        <div class="card-header">
          ヒーロー習熟度
        </div>
        <div class="card-body">
          <% if @heroes_by_role.present? %>
            <% @heroes_by_role.each do |role, proficiencies| %>
              <h5 class="mt-3"><%= Hero.human_attribute_name("role.#{role}") %></h5>
              <div class="row">
                <% proficiencies.sort_by { |p| p.hero.name }.each do |proficiency| %>
                  <div class="col-md-6 d-flex align-items-center mb-2">
                    <%= image_tag proficiency.hero.icon_url, style: "width: 40px; height: 40px; object-fit: cover; margin-right: 10px;" %>
                    <span class="me-auto"><%= proficiency.hero.name %></span>
                    <strong><%= t("enums.hero_proficiency.proficiency_level.#{proficiency.proficiency_level}") %></strong>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted">まだヒーローの習熟度が設定されていません。</p>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>

